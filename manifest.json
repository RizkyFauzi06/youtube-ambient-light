{
    "manifest_version": 3,
    "name": "YouTube Ambient Light Mentor",
    "version": "1.3.0",
    "description": "Menambahkan efek ambient light dinamis di belakang video YouTube.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Pengaturan Ambient Light"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}